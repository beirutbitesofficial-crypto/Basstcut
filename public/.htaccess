# BASST CUT — static site on Hostinger (Apache / LiteSpeed)
Options -Indexes

# Private PHP includes & config (api/_lib.php, api/_config.php) are never served directly
<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|db|log)$">
  Require all denied
</FilesMatch>
DirectoryIndex index.html index.php

# Web app
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
    Header set Service-Worker-Allowed "/"
  </Files>
</IfModule>
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets never change — cache for a year
  <FilesMatch "^.*\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
